{
  "version": 1,
  "author": "thirstyice",
	"editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": 75, "left": 150, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r2", "top": 30, "left": 150, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 70,
      "left": 110,
			"rotate": 180,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-led",
      "id": "led2",
      "top": -10,
      "left": 110,
      "attrs": { "color": "blue", "flip": "1" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "led1:A", "esp:D18", "green", [] ],
    [ "led2:A", "esp:D22", "green", [] ],
    [ "led1:C", "r1:1", "green", [] ],
    [ "led2:C", "r2:1", "green", [ "h0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ],
    [ "r2:2", "esp:GND.1", "black", [ "v0" ] ]
  ]
}